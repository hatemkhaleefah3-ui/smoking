{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smoking",
  "main": "worker/src/entry.js",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/lecture/*", "/admin"]
  },
  "vars": {
    "MAX_LECTURE_BYTES": "26214400",
    "MAX_PDF_BYTES": "26214400",
    "MAX_EXTRACTED_IMAGE_BYTES": "67108864",
    "STORAGE_ALLOWANCE_BYTES": "10000000000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lecture-links",
      "database_id": "148d7569-db72-4fde-a177-9caf040a836b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LECTURES",
      "bucket_name": "lecture-links"
    },
    {
      "binding": "PDF_EXTRACTIONS",
      "bucket_name": "lecture-links"
    }
  ],
  "observability": {
    "enabled": true
  }
}
